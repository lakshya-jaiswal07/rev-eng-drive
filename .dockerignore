# Keys and local state never go into an image
.env
.env.*
!.env.example
server/data/
*.sqlite3

# Local environments, caches and build output (rebuilt inside the image)
**/node_modules
**/.venv
**/.venv-fdb
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/.ruff_cache
web/dist
web/tsconfig.tsbuildinfo
.voices/

# Not needed by the web app
.git
.github
results/
docs/
server/tests/
server/requirements-dev.txt
server/requirements-fdb.txt
**/.DS_Store
.idea/
.vscode/
