# Keys and local state never go into an image
.env
.env.*
!.env.example

# Local environments, caches and build output (rebuilt inside the image)
**/node_modules
**/.venv
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/.ruff_cache
web/dist
web/tsconfig.tsbuildinfo

# Not needed by the web app
.git
.github
docs/
server/tests/
server/requirements-dev.txt
**/.DS_Store
.idea/
.vscode/

# accounts (SQLite) never go into an image
server/data/
*.sqlite3
